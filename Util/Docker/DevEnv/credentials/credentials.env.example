# Copy to credentials/credentials.env (chmod 600) and fill in. The folder is
# mounted read-only at /run/credentials. Never commit the real file.
# Any KEY can also be given as KEY_FILE=/run/credentials/<file> to read the value from a file.

# --- web access (empty = random password, printed in the container log)
CODE_SERVER_PASSWORD=
# ARTIFACT_PASSWORD=          # default: same as CODE_SERVER_PASSWORD
# ARTIFACT_USER=carla

# --- git identity and hosts
GIT_USER_NAME=
GIT_USER_EMAIL=
# GitHub account linked to Epic Games (needed for the UE4 fork and carla-plugins)
GITHUB_USER=
GITHUB_TOKEN=
# More hosts, any number: GIT_CREDENTIAL_<name>=https://user:token@host
# GIT_CREDENTIAL_GITLAB=https://user:token@gitlab.example.com

# --- optional: ssh key / known_hosts / corporate CA (paths inside the container)
# SSH_KEY_FILE=/run/credentials/id_ed25519
# SSH_KNOWN_HOSTS_FILE=/run/credentials/known_hosts
# CA_CERT_FILE=/run/credentials/corp-ca.crt

# --- optional: proxy and package index
# HTTP_PROXY=http://proxy:3128
# HTTPS_PROXY=http://proxy:3128
# NO_PROXY=localhost,127.0.0.1
# PIP_INDEX_URL=https://pypi.example.com/simple

# --- optional: clone CARLA when /workspace/carla is empty
# CARLA_REPO_URL=https://github.com/carla-simulator/carla
# CARLA_REPO_BRANCH=ue4-dev

# --- offline mode: pip from /opt/wheelhouse, downloads from /opt/offline-cache
# OFFLINE=1

# --- maps in the server package (Town06 = default map)
# CARLA_DEFAULT_MAPS=Town06,Town04
